rules_version = '2';

// Security model:
// - Every piece of client data lives under users/{userId}/...
//   (see lib/firestore-helpers.ts and the hooks/contexts that read & write it).
// - The browser uses the Firebase client SDK, so these rules are the ONLY thing
//   protecting that data.
// - Server-side API routes use firebase-admin (lib/firebase-admin.ts), which runs
//   with full privileges and BYPASSES these rules entirely. So cron jobs,
//   collectionGroup queries, and webhook handlers are unaffected by the deny below.
//
// Rule: a signed-in user may read & write only their own users/{uid} document
// and everything nested beneath it. Nobody can touch anyone else's data, and
// unauthenticated requests are denied everywhere.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own tree: the parent doc (users/{uid}) and all subcollections.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default. No top-level collection is read or written
    // by the client; admin SDK access (server) bypasses this regardless.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
